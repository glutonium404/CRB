# CRB Server Configuration
PORT=5340
JWT_SECRET=replace-with-a-long-random-secret

# WhatsApp Bot Configuration
BOT_PREFIX=crb
# Login method: qr (default) or code
AUTH_MODE=qr
# Required only when AUTH_MODE=code; include country code, digits only, no +
AUTH_PHONE_NUMBER=
# Comma-separated list of authorized CR / Owner phone numbers (with country code, no + or spaces)
# e.g., 8801712345678,8801812345678
OWNER_NUMBERS=

# Google Gemini API Key (Optional, for 100% Free Smart Notice Parsing)
# Get a free API key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Timezone (e.g., Asia/Dhaka, America/New_York, UTC)
TIMEZONE=Asia/Dhaka
